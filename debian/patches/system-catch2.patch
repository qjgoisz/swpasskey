Description: Allow offline builds against the system Catch2 development package
Author: Local Builder <builder@localhost.invalid>
Forwarded: no
Last-Update: 2026-11-04

--- a/cmake/FetchCatch2.cmake
+++ b/cmake/FetchCatch2.cmake
@@ -1,3 +1,10 @@
+option(SWPASSKEY_SYSTEM_CATCH2 "Use system Catch2 without downloading sources" OFF)
+if(SWPASSKEY_SYSTEM_CATCH2)
+  find_package(Catch2 3 REQUIRED CONFIG)
+  list(APPEND CMAKE_MODULE_PATH "${Catch2_DIR}")
+  return()
+endif()
+
 include(FetchContent)
 
 FetchContent_Declare(
