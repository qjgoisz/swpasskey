+// Skip a compound value without treating braces inside strings as delimiters.
+bool skip_compound(std::string_view s, std::size_t& i) {
+  std::vector<char> ends;
+  do {
+    const char c = s[i];
+    if (c == '"') {
+      std::string ignored;
+      if (!parse_string(s, i, ignored)) return false;
+      continue;
+    }
+    if (c == '{' || c == '[') {
+      ends.push_back(c == '{' ? '}' : ']');
+    } else if (c == '}' || c == ']') {
+      if (ends.empty() || ends.back() != c) return false;
+      ends.pop_back();
+    }
+    ++i;
+  } while (i < s.size() && !ends.empty());
+  return ends.empty();
+}
+
 }  // namespace
 
