+std::vector<JsonRequest> parse_object_array(std::string_view s) {
+  std::vector<JsonRequest> rows;
+  if (s.empty() || s.front() != '[') return {};
+  std::size_t i = 1;
+  skip_ws(s, i);
+  while (i < s.size() && s[i] == '{') {
+    const auto start = i;
+    if (!skip_compound(s, i)) return {};
+    auto row = parse_flat_json(s.substr(start, i - start));
+    if (!row.ok) return {};
+    rows.push_back(std::move(row));
+    skip_ws(s, i);
+    if (i == s.size() || s[i] != ',') break;
+    ++i;
+    skip_ws(s, i);
+  }
+  if (i == s.size() || s[i] != ']') return {};
+  return rows;
+}
+
 }  // namespace swpk::ctl
