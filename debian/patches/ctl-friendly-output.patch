+// Sanitize terminal controls and measure columns in display cells, not bytes.
+std::size_t display_width(std::string& value) {
+  std::mbstate_t state{};
+  std::size_t width = 0;
+  for (std::size_t i = 0; i < value.size();) {
+    wchar_t ch{};
+    const auto count = std::mbrtowc(&ch, value.data() + i, value.size() - i, &state);
+    const bool invalid = count == static_cast<std::size_t>(-1) ||
+                         count == static_cast<std::size_t>(-2);
+    const auto bytes = invalid || count == 0 ? 1 : count;
+    const int cells = invalid || count == 0 ? -1 : ::wcwidth(ch);
+    if (cells < 0) {
+      value.replace(i, bytes, "?");
+      ++i;
+      ++width;
+      state = {};
+    } else {
+      i += bytes;
+      width += static_cast<std::size_t>(cells);
+    }
+  }
+  return width;
 }
 
